{
  "name": "sentinelbox-website",
  "private": true,
  "version": "2.0.0",
  "description": "Project website for SentinelBox (https://sentinelbox.mingchen.dev)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "sync-data": "node scripts/sync-data.mjs",
